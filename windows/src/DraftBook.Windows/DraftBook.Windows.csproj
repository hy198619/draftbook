<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DraftBook.ico</ApplicationIcon>
    <StartupObject>DraftBook.Windows.App</StartupObject>
    <AssemblyName>DraftBook</AssemblyName>
    <RootNamespace>DraftBook.Windows</RootNamespace>
    <Product>DraftBook 草稿本</Product>
    <Description>面向电脑深度工作场景的轻量草稿工具</Description>
    <Authors>杨昱轩</Authors>
    <Version>0.9.6-preview.4</Version>
    <AssemblyVersion>0.9.6.0</AssemblyVersion>
    <FileVersion>0.9.6.4</FileVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <ProjectReference Include="../DraftBook.Core/DraftBook.Core.csproj" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <Resource Include="Assets\DraftBook.ico" />
    <Content Include="Assets\THIRD_PARTY_NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
