<Window x:Class="DraftBook.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DraftBook.Windows"
        Title="DraftBook · 草稿本" Width="560" Height="820" MinWidth="360" MinHeight="520"
        Background="{StaticResource WindowBackground}" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="草稿本(_D)">
                <MenuItem Header="导出 TXT…" Click="ExportText_Click" />
                <MenuItem Header="导出 Markdown…" Click="ExportMarkdown_Click" />
                <MenuItem Header="导出完整备份…" Click="ExportBackup_Click" />
                <MenuItem Header="从完整备份恢复…" Click="RestoreBackup_Click" />
                <Separator />
                <MenuItem Header="退出" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="设置(_S)" Click="Settings_Click" />
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="添加功能示例" Click="InstallSamples_Click" />
                <MenuItem Header="移除功能示例" Click="RemoveSamples_Click" />
                <Separator />
                <MenuItem Header="功能说明" Click="Guide_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" BorderBrush="#18000000" BorderThickness="0,1,0,0" Padding="10,6">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedForeground}" FontSize="11" Text="已就绪" />
        </Border>

        <Grid Margin="14,10,14,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="SectionPicker" Width="116" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="草稿" Tag="active" IsSelected="True" />
                    <ComboBoxItem Content="清理台" Tag="due" />
                    <ComboBoxItem Content="存档" Tag="archived" />
                    <ComboBoxItem Content="回收站" Tag="trash" />
                </ComboBox>
                <TextBox x:Name="SearchBox" Grid.Column="1" Margin="8,0" VerticalContentAlignment="Center"
                         ToolTip="搜索标题和正文" TextChanged="Filter_Changed" />
                <ComboBox x:Name="ColorPicker" Grid.Column="2" Width="94" SelectionChanged="Filter_Changed" />
            </Grid>

            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8"
                    BorderBrush="#1C000000" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:ImeAwareTextBox x:Name="ComposerBox" AcceptsReturn="True" TextWrapping="Wrap"
                                           MinHeight="68" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                           BorderThickness="0" Padding="2" CommitRequested="Composer_CommitRequested"
                                           TextChanged="Composer_TextChanged" />
                    <Button Grid.Column="1" Content="划定" VerticalAlignment="Bottom" Click="Seal_Click"
                            ToolTip="Ctrl+Enter" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DraftPanel" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
