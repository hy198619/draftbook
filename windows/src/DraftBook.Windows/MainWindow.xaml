<Window x:Class="DraftBook.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DraftBook.Windows"
        Title="草稿本"
        Icon="Assets/DraftBook.ico"
        Width="420"
        Height="680"
        MinWidth="360"
        MinHeight="380"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="Search_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Command="ApplicationCommands.Find" Gesture="Ctrl+F" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="SectionButton"
                        Padding="4,2"
                        MinHeight="30"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="SectionButton_Click"
                        AutomationProperties.Name="切换草稿区域">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SectionTitle" Text="草稿区" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Margin="6,1,0,0"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="9"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   Text="&#xE70D;" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="草稿区" Tag="active" Click="SectionMenuItem_Click" />
                            <MenuItem x:Name="DueMenuItem" Header="清理台" Tag="due" Click="SectionMenuItem_Click" />
                            <MenuItem Header="存档区" Tag="archived" Click="SectionMenuItem_Click" />
                            <MenuItem x:Name="TrashMenuItem" Header="回收站" Tag="trash" Click="SectionMenuItem_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <TextBlock Grid.Column="1"
                           Margin="12,0,8,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           Text="写完一条，记得 Ctrl+Enter 划定草稿"
                           TextTrimming="CharacterEllipsis" />

                <ToggleButton x:Name="SearchButton"
                              Grid.Column="2"
                              Style="{StaticResource IconToggleButtonStyle}"
                              Content="&#xE721;"
                              ToolTip="搜索草稿（Ctrl+F）"
                              Click="SearchButton_Click"
                              AutomationProperties.Name="搜索草稿" />

                <Button x:Name="MoreButton"
                        Grid.Column="3"
                        Style="{StaticResource IconButtonStyle}"
                        Content="&#xE712;"
                        ToolTip="更多"
                        Click="MoreButton_Click"
                        AutomationProperties.Name="更多操作">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="导出 TXT…" Click="ExportText_Click" />
                            <MenuItem Header="导出 Markdown…" Click="ExportMarkdown_Click" />
                            <MenuItem Header="导出完整备份…" Click="ExportBackup_Click" />
                            <MenuItem Header="从完整备份恢复…" Click="RestoreBackup_Click" />
                            <Separator />
                            <MenuItem Header="设置…" Click="Settings_Click" />
                            <MenuItem x:Name="CheckForUpdatesMenuItem"
                                      Header="检查更新…"
                                      Click="CheckForUpdates_Click" />
                            <MenuItem Header="功能说明" Click="Guide_Click" />
                            <MenuItem Header="添加功能示例" Click="InstallSamples_Click" />
                            <MenuItem Header="移除功能示例" Click="RemoveSamples_Click" />
                            <Separator />
                            <MenuItem Header="恢复默认窗口大小和位置" Click="ResetWindowPlacement_Click" />
                            <MenuItem Header="退出" Click="Exit_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <ToggleButton x:Name="PinButton"
                              Grid.Column="4"
                              Style="{StaticResource IconToggleButtonStyle}"
                              Content="&#xE718;"
                              ToolTip="窗口始终置顶"
                              Click="PinButton_Click"
                              AutomationProperties.Name="窗口始终置顶" />
            </Grid>
        </Border>

        <Border x:Name="SearchHost"
                Grid.Row="1"
                Visibility="Collapsed"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                BorderThickness="0,0,0,1"
                Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontFamily="Segoe MDL2 Assets"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           Text="&#xE721;" />
                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         ToolTip="搜索标题和正文"
                         TextChanged="Filter_Changed"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"
                         AutomationProperties.Name="搜索标题和正文" />
                <Button x:Name="ClearSearchButton"
                        Grid.Column="2"
                        Style="{StaticResource IconButtonStyle}"
                        Width="28"
                        Height="28"
                        MinHeight="28"
                        Content="&#xE711;"
                        Visibility="Collapsed"
                        ToolTip="清除搜索"
                        Click="ClearSearchButton_Click"
                        AutomationProperties.Name="清除搜索" />
                <ComboBox x:Name="ColorPicker"
                          Grid.Column="3"
                          Width="108"
                          Margin="6,0,0,0"
                          SelectionChanged="Filter_Changed"
                          AutomationProperties.Name="按标签筛选" />
            </Grid>
        </Border>

        <Border x:Name="ComposerHost"
                Grid.Row="2"
                Margin="16,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock x:Name="ComposerPlaceholder"
                           Margin="4,16,4,0"
                           VerticalAlignment="Top"
                           FontSize="15"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           Text="直接写下来……"
                           IsHitTestVisible="False" />
                <local:ImeAwareTextBox x:Name="ComposerBox"
                                       AcceptsReturn="True"
                                       TextWrapping="Wrap"
                                       MinHeight="92"
                                       MaxHeight="240"
                                       Padding="4,13,4,12"
                                       FontSize="15"
                                       VerticalScrollBarVisibility="Auto"
                                       BorderThickness="0"
                                       Background="Transparent"
                                       CommitRequested="Composer_CommitRequested"
                                       TextChanged="Composer_TextChanged"
                                       AutomationProperties.Name="新草稿输入框" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3"
                      Margin="16,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
            <!-- Draft cards have variable heights. Physical (pixel) scrolling keeps
                 wheel movement consistent instead of jumping by whole cards. -->
            <StackPanel x:Name="DraftPanel" />
        </ScrollViewer>

        <Border x:Name="StatusToast"
                Grid.RowSpan="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="16"
                Padding="12,7"
                CornerRadius="14"
                Background="{StaticResource HintSurfaceBrush}"
                Visibility="Collapsed"
                Panel.ZIndex="10">
            <TextBlock x:Name="StatusText"
                       Foreground="{StaticResource HintForegroundBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       MaxWidth="320"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>

        <Popup x:Name="TopmostHintPopup"
               PlacementTarget="{Binding ElementName=PinButton}"
               Placement="Bottom"
               HorizontalOffset="-205"
               VerticalOffset="2"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="False">
            <StackPanel Width="238">
                <Path Data="M 0 8 L 8 0 L 16 8 Z"
                      Fill="{StaticResource HintSurfaceBrush}"
                      HorizontalAlignment="Right"
                      Margin="0,0,10,-1" />
                <Border Background="{StaticResource HintSurfaceBrush}"
                        CornerRadius="8"
                        Padding="13,10">
                    <TextBlock Foreground="{StaticResource HintForegroundBrush}"
                               FontSize="12"
                               TextWrapping="Wrap">
                        <Run Text="点击 " />
                        <Run FontFamily="Segoe MDL2 Assets" Text="&#xE718;" />
                        <Run Text=" 可以将草稿本窗口始终置顶" />
                    </TextBlock>
                </Border>
            </StackPanel>
        </Popup>
    </Grid>
</Window>
